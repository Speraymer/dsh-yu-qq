{
    "name":  "dsh-yu-qq",
    "version": "2.0.3",
    "description":  "DSH QQ 双向桥：群聊和私聊分会话、点名响应、离线补收、引用与表情支持。",
    "license":  "MIT",
    "type":  "module",
    "scripts":  {
                    "test:security":  "node --test tests/security.test.mjs"
                },
    "main":  "lib/host.js",
    "exports":  {
                    ".":  "./lib/host.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "CHANGELOG.md",
                  "LICENSE",
                  "tools"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "slots"
                                          ],
                               "external":  [
                                                "react"
                                            ]
                           }
            },
    "author":  "Speraymer",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Speraymer/dsh-yu-qq.git"
                   },
    "homepage":  "https://github.com/Speraymer/dsh-yu-qq#readme",
    "bugs":  {
                 "url":  "https://github.com/Speraymer/dsh-yu-qq/issues"
             },
    "publishConfig":  {
                          "access":  "public",
                          "registry":  "https://registry.npmjs.org/"
                      },
    "keywords":  [
                     "deepseek-harness",
                     "dsh-plugin"
                 ]
}